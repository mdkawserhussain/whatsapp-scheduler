# ── Targets (comma-separated) ──
# IMPORTANT: Replace XXXXXXXXX with real numbers
# Format: country code + number + @c.us, comma-separated for multiple
# Example: 8801712345678@c.us,8801827879271@c.us
TARGET_PHONE=8801XXXXXXXXX@c.us

# ── Timezone ──
TIMEZONE=Asia/Dhaka

# ── Cron Schedules (minute hour * * *) ──
MORNING_TEXT_CRON=30 9 * * *
MORNING_VOICE_CRON=0 10 * * *
AFTERNOON_TEXT_CRON=0 14 * * *
AFTERNOON_VOICE_CRON=30 14 * * *

# ── Audio ──
VOICE_FILE=voice.ogg

# ── Notifications (optional) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Logging ──
LOG_LEVEL=info
LOG_FILE=scheduler.log
